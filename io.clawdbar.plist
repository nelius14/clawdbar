<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.clawdbar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/REPLACE_USER/.clawdbar/.venv/bin/python3</string>
        <string>/Users/REPLACE_USER/.clawdbar/daemon/daemon.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_USER/.clawdbar</string>

    <!-- Tunable knobs (see CLAUDE.md / README). All optional; these are the
         code defaults made explicit so they're easy to adjust in one place.
         Edit a value, then: launchctl kickstart -k gui/$(id -u)/io.clawdbar -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>CLAWDBAR_POLL</key>
        <string>60</string>
        <key>CLAWDBAR_ACTIVE_WINDOW</key>
        <string>720</string>
        <key>CLAWDBAR_PROJECTS</key>
        <string>/Users/REPLACE_USER/.claude/projects</string>
        <key>CLAWDBAR_CREDENTIALS</key>
        <string>/Users/REPLACE_USER/.claude/.credentials.json</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE_USER/Library/Logs/clawdbar.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_USER/Library/Logs/clawdbar.err.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
