<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.clawdbar.menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/REPLACE_USER/.clawdbar/.venv/bin/python3</string>
        <string>/Users/REPLACE_USER/.clawdbar/menubar/clawdbar_menubar.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_USER/.clawdbar</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart only on a crash. "Quit Clawdbar" calls NSApp.terminate_(),
         which exits 0; an unconditional KeepAlive would relaunch the app and
         make Quit look like a reload. RunAtLoad still brings it back at login. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE_USER/Library/Logs/clawdbar-menubar.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_USER/Library/Logs/clawdbar-menubar.err.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
